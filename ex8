%{
#include <stdio.h>
#include <stdlib.h>
#include <math.h>

void yyerror(const char *s);
int yylex(void);
%}

%token NUMBER
%token ADD SUB MUL DIV MOD POW LPAREN RPAREN NEWLINE

%left ADD SUB
%left MUL DIV MOD
%right POW

%%

calculation:

    | calculation line
    ;

line:
    NEWLINE
    | exp NEWLINE {
        printf("Production used: line -> exp NEWLINE\n");
        printf("Result: %d\n\n", $1);
    }
    ;

exp:
    NUMBER          {
                        printf("Production used: exp -> NUMBER (%d)\n", $1);
                        $$ = $1;
                    }
    | exp ADD exp   {
                        printf("Production used: exp -> exp ADD exp (%d + %d)\n", $1, $3);
                        $$ = $1 + $3;
                    }
    | exp SUB exp   {
                        printf("Production used: exp -> exp SUB exp (%d - %d)\n", $1, $3);
                        $$ = $1 - $3;
                    }
    | exp MUL exp   {
                        printf("Production used: exp -> exp MUL exp (%d * %d)\n", $1, $3);
                        $$ = $1 * $3;
                    }
    | exp DIV exp   {
                        printf("Production used: exp -> exp DIV exp (%d / %d)\n", $1, $3);
                        if ($3 == 0) {
                            yyerror("Error: Division by zero");
                            $$ = 0;
                        } else {
                            $$ = $1 / $3;
                        }
                    }
    | exp MOD exp   {
                        printf("Production used: exp -> exp MOD exp (%d %% %d)\n", $1, $3);
                        if ($3 == 0) {
                            yyerror("Error: Modulo by zero");
                            $$ = 0;
                        } else {
                            $$ = $1 % $3;
                        }
                    }
    | exp POW exp   {
                        printf("Production used: exp -> exp POW exp (%d ^ %d)\n", $1, $3);
                        $$ = (int)pow($1, $3);
                    }
    | LPAREN exp RPAREN {
                        printf("Production used: exp -> LPAREN exp RPAREN\n");
                        $$ = $2;
                    }
    ;

%%

void yyerror(const char *s) {
    fprintf(stderr, "%s\n", s);
}

int main(void) {
    printf("Enter expression (e.g., 2 + 3 * 4 or 2^3%%3):\n");
    yyparse();
    return 0;
}
