%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAXQ 200

int yylex(void);
void yyerror(const char *s);

struct Quad
{
    char tac[80];
    char op[16];
    char arg1[32];
    char arg2[32];
    char result[32];
};

struct Quad quad[MAXQ];

int qcount = 0;
int tcount = 0;
int lcount = 0;

char thenLabel[32];
char exitLabel[32];

char condLeft[32];
char condOp[16];
char condRight[32];

void addquad(const char *tac, const char *op,
             const char *a1, const char *a2,
             const char *res)
{
    if (qcount >= MAXQ)
    {
        printf("Quadruple table is full\n");
        exit(1);
    }

    snprintf(quad[qcount].tac, sizeof(quad[qcount].tac),
             "%s", tac);
    snprintf(quad[qcount].op, sizeof(quad[qcount].op),
             "%s", op);
    snprintf(quad[qcount].arg1, sizeof(quad[qcount].arg1),
             "%s", a1);
    snprintf(quad[qcount].arg2, sizeof(quad[qcount].arg2),
             "%s", a2);
    snprintf(quad[qcount].result, sizeof(quad[qcount].result),
             "%s", res);

    qcount++;
}

char *newtemp(void)
{
    char *s = malloc(32);
    if (!s) exit(1);

    sprintf(s, "t%d", ++tcount);
    return s;
}

char *newlabel(void)
{
    char *s = malloc(32);
    if (!s) exit(1);

    sprintf(s, "L%d", ++lcount);
    return s;
}

void emitLabel(const char *label)
{
    char tac[80];

    snprintf(tac, sizeof(tac), "%s:", label);
    addquad(tac, "label", "-", "-", label);
}

void emitGoto(const char *label)
{
    char tac[80];

    snprintf(tac, sizeof(tac), "goto %s", label);
    addquad(tac, "goto", "-", "-", label);
}

void emitRelBranch(const char *a1, const char *op,
                   const char *a2, const char *label)
{
    char tac[80];

    snprintf(tac, sizeof(tac), "if %s %s %s goto %s",
             a1, op, a2, label);

    addquad(tac, op, a1, a2, label);
}

void printTAC(void)
{
    int i;

    printf("\nTHREE ADDRESS CODE\n");
    printf("----------------------------------------\n");

    for (i = 0; i < qcount; i++)
        printf("%s\n", quad[i].tac);
}

void printQuad(void)
{
    int i;

    printf("\nQUADRUPLE TABLE\n");
    printf("--------------------------------------------------------------------------------\n");

    printf("%-32s | %-10s | %-8s | %-8s | %-8s\n",
           "THREE ADDRESS CODE", "OPERATOR",
           "ARG1", "ARG2", "RESULT");

    printf("--------------------------------------------------------------------------------\n");

    for (i = 0; i < qcount; i++)
    {
        printf("%-32s | %-10s | %-8s | %-8s | %-8s\n",
               quad[i].tac, quad[i].op,
               quad[i].arg1, quad[i].arg2,
               quad[i].result);
    }

    printf("--------------------------------------------------------------------------------\n");
}
%}

%union
{
    char *str;
}

%token IF
%token <str> ID NUM RELOP

%type <str> expr term factor comparison

%left '+' '-'
%left '*' '/'

%%

program
    : stmt
      {
          printTAC();
          printQuad();
      }
    ;

stmt
    : ID '=' expr ';'
      {
          char tac[80];

          snprintf(tac, sizeof(tac), "%s = %s", $1, $3);

          addquad(tac, "=", $3, "-", $1);
      }
    | IF '(' comparison ')'
      {
          strcpy(thenLabel, newlabel());
          strcpy(exitLabel, newlabel());

          emitRelBranch(condLeft, condOp,
                        condRight, thenLabel);

          emitGoto(exitLabel);
          emitLabel(thenLabel);
      }
      stmt
      {
          emitLabel(exitLabel);
      }
    ;

comparison
    : expr RELOP expr
      {
          snprintf(condLeft, sizeof(condLeft), "%s", $1);
          snprintf(condOp, sizeof(condOp), "%s", $2);
          snprintf(condRight, sizeof(condRight), "%s", $3);

          $$ = $1;
      }
    ;

expr
    : expr '+' term
      {
          char *temp = newtemp();
          char tac[80];

          snprintf(tac, sizeof(tac), "%s = %s + %s",
                   temp, $1, $3);

          addquad(tac, "+", $1, $3, temp);
          $$ = temp;
      }
    | expr '-' term
      {
          char *temp = newtemp();
          char tac[80];

          snprintf(tac, sizeof(tac), "%s = %s - %s",
                   temp, $1, $3);

          addquad(tac, "-", $1, $3, temp);
          $$ = temp;
      }
    | term
      {
          $$ = $1;
      }
    ;

term
    : term '*' factor
      {
          char *temp = newtemp();
          char tac[80];

          snprintf(tac, sizeof(tac), "%s = %s * %s",
                   temp, $1, $3);

          addquad(tac, "*", $1, $3, temp);
          $$ = temp;
      }
    | term '/' factor
      {
          char *temp = newtemp();
          char tac[80];

          snprintf(tac, sizeof(tac), "%s = %s / %s",
                   temp, $1, $3);

          addquad(tac, "/", $1, $3, temp);
          $$ = temp;
      }
    | factor
      {
          $$ = $1;
      }
    ;

factor
    : ID
      {
          $$ = $1;
      }
    | NUM
      {
          $$ = $1;
      }
    | '(' expr ')'
      {
          $$ = $2;
      }
    ;

%%

void yyerror(const char *s)
{
    fprintf(stderr, "Syntax error: %s\n", s);
}

