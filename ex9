%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAXQ 500

int yylex(void);
void yyerror(const char *s);

struct Quad
{
    char tac[100];
    char op[20];
    char arg1[40];
    char arg2[40];
    char result[40];
};

struct Quad quad[MAXQ], incQuad[100];

int qcount = 0, incCount = 0;
int capture = 0, tcount = 0, lcount = 0;

char loopStart[20], bodyLabel[20], exitLabel[20];

char *duplicate(const char *s)
{
    char *p = malloc(strlen(s) + 1);
    if (!p)
        exit(1);

    strcpy(p, s);
    return p;
}

char *newtemp(void)
{
    char b[20];
    sprintf(b, "t%d", ++tcount);
    return duplicate(b);
}

char *newlabel(void)
{
    char b[20];
    sprintf(b, "L%d", ++lcount);
    return duplicate(b);
}

void addquad(const char *tac, const char *op,
             const char *a1, const char *a2,
             const char *res)
{
    struct Quad *q = capture ? incQuad : quad;
    int *n = capture ? &incCount : &qcount;
    int limit = capture ? 100 : MAXQ;

    if (*n >= limit)
    {
        fprintf(stderr, "Quadruple table full\n");
        exit(1);
    }

    snprintf(q[*n].tac, sizeof(q[*n].tac), "%s", tac);
    snprintf(q[*n].op, sizeof(q[*n].op), "%s", op);
    snprintf(q[*n].arg1, sizeof(q[*n].arg1), "%s", a1);
    snprintf(q[*n].arg2, sizeof(q[*n].arg2), "%s", a2);
    snprintf(q[*n].result, sizeof(q[*n].result), "%s", res);

    (*n)++;
}

void assign(const char *id, const char *value)
{
    char tac[100];

    snprintf(tac, sizeof(tac), "%s = %s", id, value);
    addquad(tac, "=", value, "-", id);
}

void operation(const char *op, const char *a,
               const char *b, char *temp)
{
    char tac[100];

    snprintf(tac, sizeof(tac), "%s = %s %s %s",
             temp, a, op, b);

    addquad(tac, op, a, b, temp);
}

void arrayload(const char *array, const char *index,
               char *temp)
{
    char tac[100];

    snprintf(tac, sizeof(tac), "%s = %s[%s]",
             temp, array, index);

    addquad(tac, "=[]", array, index, temp);
}

void emitLabel(const char *name)
{
    char tac[100];

    snprintf(tac, sizeof(tac), "%s:", name);
    addquad(tac, "label", "-", "-", name);
}

void emitGoto(const char *name)
{
    char tac[100];

    snprintf(tac, sizeof(tac), "goto %s", name);
    addquad(tac, "goto", "-", "-", name);
}

void emitCondition(const char *a, const char *op,
                   const char *b, const char *dest)
{
    char tac[100];

    snprintf(tac, sizeof(tac), "if %s %s %s goto %s",
             a, op, b, dest);

    addquad(tac, op, a, b, dest);
}

void appendIncrement(void)
{
    int i;

    for (i = 0; i < incCount; i++)
    {
        addquad(incQuad[i].tac, incQuad[i].op,
                incQuad[i].arg1, incQuad[i].arg2,
                incQuad[i].result);
    }
}

void printResult(void)
{
    int i;

    printf("\n========== THREE ADDRESS CODE ==========\n");

    for (i = 0; i < qcount; i++)
        printf("%s\n", quad[i].tac);

    printf("\n================ QUADRUPLE TABLE ================\n");

    printf("%-30s | %-8s | %-8s | %-8s | %-8s\n",
           "THREE ADDRESS CODE", "OPERATOR",
           "ARG1", "ARG2", "RESULT");

    printf("---------------------------------------------------------------\n");

    for (i = 0; i < qcount; i++)
    {
        printf("%-30s | %-8s | %-8s | %-8s | %-8s\n",
               quad[i].tac, quad[i].op,
               quad[i].arg1, quad[i].arg2,
               quad[i].result);
    }

    printf("---------------------------------------------------------------\n");
}
%}

%union
{
    char *str;
}

%token FOR INC
%token <str> ID NUM RELOP

%type <str> expr term factor

%left '+' '-'
%left '*' '/'

%%

program
    : forstmt
      {
          printResult();
      }
    ;

forstmt
    : FOR '(' init ';'
      {
          strcpy(loopStart, newlabel());
          emitLabel(loopStart);
      }
      condition ';'
      {
          capture = 1;
          incCount = 0;
      }
      increment
      {
          capture = 0;
      }
      ')' '{' stmt '}'
      {
          appendIncrement();
          emitGoto(loopStart);
          emitLabel(exitLabel);
      }
    ;

init
    : ID '=' expr
      {
          assign($1, $3);
      }
    ;

condition
    : expr RELOP expr
      {
          strcpy(bodyLabel, newlabel());
          strcpy(exitLabel, newlabel());

          emitCondition($1, $2, $3, bodyLabel);
          emitGoto(exitLabel);
          emitLabel(bodyLabel);
      }
    ;

increment
    : ID '=' expr
      {
          assign($1, $3);
      }
    | ID INC
      {
          char *t = newtemp();
          operation("+", $1, "1", t);
          assign($1, t);
      }
    ;

stmt
    : ID '=' expr ';'
      {
          assign($1, $3);
      }
    ;

expr
    : expr '+' term
      {
          char *t = newtemp();
          operation("+", $1, $3, t);
          $$ = t;
      }
    | expr '-' term
      {
          char *t = newtemp();
          operation("-", $1, $3, t);
          $$ = t;
      }
    | term
      {
          $$ = $1;
      }
    ;

term
    : term '*' factor
      {
          char *t = newtemp();
          operation("*", $1, $3, t);
          $$ = t;
      }
    | term '/' factor
      {
          char *t = newtemp();
          operation("/", $1, $3, t);
          $$ = t;
      }
    | factor
      {
          $$ = $1;
      }
    ;

factor
    : ID
      {
          $$ = $1;
      }
    | NUM
      {
          $$ = $1;
      }
    | '(' expr ')'
      {
          $$ = $2;
      }
    | ID '[' expr ']'
      {
          char *offset = newtemp();
          char *value = newtemp();

          /* Calculate byte offset: index * 4 */
          operation("*", $3, "4", offset);

          /* Load the array element using the offset */
          arrayload($1, offset, value);

          $$ = value;
      }
    ;

%%

void yyerror(const char *s)
{
    fprintf(stderr, "Syntax error: %s\n", s);
}

int main(void)
{
    printf("Enter the for-loop statement:\n");
    return yyparse();vi c
